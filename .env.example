# ===========================================
# Variables de Entorno - Sistema La Fuga
# ===========================================
# Copia este archivo como .env.local y completa los valores

# ============ SUPABASE (OBLIGATORIO) ============
# Obtener en: https://supabase.com/dashboard/project/TU_PROYECTO/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ============ MCP PARA CLAUDE (OPCIONAL) ============
# URL pública del servidor MCP remoto. Si ponés solo el dominio, el server normaliza a /mcp.
LAFUGA_MCP_BASE_URL=https://mcp.tu-dominio.com/mcp
# Puerto local donde va a escuchar el servidor cuando se ejecute como proceso Node.
LAFUGA_MCP_PORT=3018
# Host de escucha del proceso Node.
LAFUGA_MCP_HOST=0.0.0.0
# Orígenes permitidos para CORS si querés probarlo desde navegador o inspector web.
LAFUGA_MCP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274
# Prefijo visible para los tokens Bearer generados para Claude.
LAFUGA_MCP_TOKEN_PREFIX=lfmcp_live
# Modo solo lectura para bloquear cualquier cambio desde Claude.
LAFUGA_MCP_READONLY=false
# Porcentaje máximo permitido para actualizaciones masivas.
LAFUGA_MCP_MAX_BULK_PERCENT=35
# Roles permitidos para cambios directos y masivos.
LAFUGA_MCP_MUTATION_ROLES=admin,editor,supervisor,gerente
LAFUGA_MCP_BULK_ROLES=admin,supervisor,gerente
LAFUGA_MCP_CONFIG_ROLES=admin,gerente

# Service role key. SOLO server-side (no exponer al cliente). Usado por el
# servidor MCP para leer/escribir productos saltando RLS y aplicando
# autorización por rol en código.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ============ MCP SERVER ============
# URL pública donde está deployado el sistema. Usada por los endpoints OAuth
# (issuer, redirects, discovery). En Vercel suele setearse automáticamente.
NEXT_PUBLIC_APP_URL=https://sistema-lafuga.vercel.app

# ============ AUTENTICACION (OPCIONAL) ============
# Google OAuth - Obtener en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# ============ SEGURIDAD ============
# Lista de emails permitidos (separados por coma)
# Dejar vacio para permitir cualquier email de Google
ALLOWED_EMAILS=usuario1@gmail.com,usuario2@gmail.com

# ============ BÚSQUEDA DE IMÁGENES (OPCIONAL) ============
# Google Custom Search API - 100 búsquedas gratis/día
# Obtener API Key en: https://console.cloud.google.com/ (habilitar Custom Search API)
# Obtener Search Engine ID en: https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=AIzaSy_tu_api_key
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=tu_search_engine_id

# Open Food Facts - Gratuito, sin límite
# User-Agent para identificar tu aplicación (buena práctica)
OPENFOODFACTS_USER_AGENT=LaFugaSystem/1.0 (contacto@lafuga.com)
